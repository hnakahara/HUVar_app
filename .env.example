# ---- テスト環境用 環境変数テンプレート ----
# 実際の値を入れて .env として保存する（.env はリポジトリ非追跡）

# Django
DEBUG=1
SECRET_KEY=change-me-in-real-env
DJANGO_SETTINGS_MODULE=config.settings.test
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# サブパス（vas と同一ドメインの /acmg 配下で提供）
FORCE_SCRIPT_NAME=/acmg

# PostgreSQL
POSTGRES_NAME=huvar
POSTGRES_USER=huvar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me

# TransVar サービス
TRANSVAR_SERVICE_URL=http://transvar:5000
# MANE summary（transvar コンテナ内パス）。未設定なら HUVar 参照データの
# shared/MANE.GRCh38.v1.5.summary.txt.gz（HUVar の setup_data.py --only mane-summary）を読む。
# MANE_SUMMARY=/data/shared/MANE.GRCh38.v1.5.summary.txt.gz

# 管理者通知（アカウント発行リクエスト先）
ADMIN_ADDRESS=
GMAIL_ADDRESS=
GMAIL_PASS=

# ジョブ成果物（アップロードVCF・生成TSV）の保持時間（時間）
JOB_ARTIFACT_RETENTION_HOURS=1

# in silico 予測ツール（PP3/BP4）。既定は ESM1b。FuncVEP-CTI は非商用限定のため、
# スコアファイル（TSV / VCF、bgzip + tabix）を配置したときだけ選択できる。
# HUVAR_FUNCVEP=0 で選択肢から隠す。
# ACMG_FUNCVEP_GRCH38=/tools/funcvep/FuncVEP_CTI_hg38.vcf.gz
# ACMG_FUNCVEP_GRCH37=/tools/funcvep/FuncVEP_CTI_hg37.vcf.gz
# ACMG_MAVEDB_RESEARCH_USE=true   # MaveDB research-use-only 較正（ExCALIBR）を使う（既定 OFF）

# --- セキュリティ ---
# 前段の信頼できるリバースプロキシの段数（vas の nginx 1 段なら 1。プロキシ無しなら 0）。
# X-Forwarded-For の右端からこの位置を接続元 IP とする（ログイン失敗のロックアウト・
# 送信回数制限・監査ログ・通知に使用）。
# TRUSTED_PROXY_COUNT=1
# 管理画面(/acmg/admin/)を許可するネットワーク（カンマ区切り CIDR）。未設定なら制限なし。
# 許可外からは 404。自分の接続元が含まれることを確認してから設定すること。
# ADMIN_ALLOWED_NETWORKS=133.41.0.0/16
# API トークンの有効期限（発行からの日数。0 で無期限）。期限切れは管理者が再発行する。
# API_TOKEN_MAX_AGE_DAYS=365
# セキュリティ通知のしきい値（10 分間のログイン失敗: 同一 IP / サイト全体、MFA 連続失敗）
# SECURITY_LOGIN_FAILURES_PER_IP=10
# SECURITY_LOGIN_FAILURES_TOTAL=30
# SECURITY_MFA_FAILURES=3

# --- バッチ解析の制限時間・並列数 ---
# バッチ 1 件の解析時間の上限（時間）。超えたら解析を打ち切り「失敗（制限時間超過）」にする。
# BATCH_TIME_LIMIT_HOURS=12
# バッチ解析だけの並列数（単一変異の解析には影響しない）。VEP の --fork 合計・注釈の
# 並列スレッド数（既定 4）。サーバーのコア数とメモリに合わせて増やすと大きな VCF が速くなる。
# HUVAR_BATCH_WORKERS=12
# バッチの判定（クライテリア評価）を複数プロセスで行う場合のプロセス数（既定 1）。
# HUVAR_BATCH_CLASSIFY_WORKERS=4
