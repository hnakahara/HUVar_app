# ---- 本番環境用 環境変数テンプレート ----
# 実際の値を入れて .env.prod として保存する（.env.prod はリポジトリ非追跡）

# Django
DEBUG=0
# SECRET_KEY は「$」を含めないこと（docker compose の変数展開で壊れる）。
# 生成例: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=__REPLACE_WITH_STRONG_RANDOM_SECRET_NO_DOLLAR__
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=1603-027.a.hiroshima-u.ac.jp

# サブパス（vas と同一ドメインの /acmg 配下で提供）
FORCE_SCRIPT_NAME=/acmg

# PostgreSQL
POSTGRES_NAME=huvar
POSTGRES_USER=huvar
POSTGRES_PASSWORD=__REPLACE__
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
# REDIS_PASSWORD も「$」を含めないこと（compose の変数展開で壊れ、警告/不整合の原因）。
# 生成例: python -c "import secrets;print(secrets.token_urlsafe(24))"
# REDIS_URL のパスワード部は REDIS_PASSWORD と必ず一致させる。
REDIS_URL=redis://:__REPLACE_NO_DOLLAR__@redis:6379/0
REDIS_PASSWORD=__REPLACE_NO_DOLLAR__

# TransVar サービス
TRANSVAR_SERVICE_URL=http://transvar:5000
# MANE summary（transvar コンテナ内パス）。未設定なら HUVar 参照データの
# shared/MANE.GRCh38.v1.5.summary.txt.gz（HUVar の setup_data.py --only mane-summary）を読む。
# MANE_SUMMARY=/data/shared/MANE.GRCh38.v1.5.summary.txt.gz

# 管理者通知（アカウント発行リクエスト先）
ADMIN_ADDRESS=
GMAIL_ADDRESS=
GMAIL_PASS=

# ジョブ成果物（アップロードVCF・生成TSV）の保持時間（時間）
JOB_ARTIFACT_RETENTION_HOURS=1

# in silico 予測ツール（PP3/BP4）。既定は ESM1b。FuncVEP-CTI は PolyForm Strict
# （非商用限定・再配布不可）のため、スコアファイルを配置したときだけ選択できる。
# HUVAR_FUNCVEP=0 で選択肢から隠す。
# HUVAR_FUNCVEP=1
# FuncVEP-CTI のスコアファイル（TSV / VCF どちらでも可、bgzip + tabix）。
# /data 配下（<assembly>/funcvep/funcvep_cti_<asm>.{tsv,vcf}.gz）に置かない場合に指定する。
# VEP --custom 用に作成済みの VCF をそのまま参照できる（再変換不要）。
# ACMG_FUNCVEP_GRCH38=/tools/funcvep/FuncVEP_CTI_hg38.vcf.gz
# ACMG_FUNCVEP_GRCH37=/tools/funcvep/FuncVEP_CTI_hg37.vcf.gz

# MaveDB の research-use-only 較正（ExCALIBR）も PS3/BS3 に使う（既定 OFF）。
# 臨床用較正が優先され、BRCA1/2 は ENIGMA Table 9 未収載の変異のみ評価する。
# 根拠には "research use only" と表示される。切り替えるとキャッシュは自動で無効化される。
# ACMG_MAVEDB_RESEARCH_USE=true

# --- セキュリティ ---
# 前段の信頼できるリバースプロキシの段数（vas の nginx 1 段なら 1。プロキシ無しなら 0）。
# X-Forwarded-For の右端からこの位置を接続元 IP とする（ログイン失敗のロックアウト・
# 送信回数制限・監査ログ・通知に使用）。
# TRUSTED_PROXY_COUNT=1
# 管理画面(/acmg/admin/)を許可するネットワーク（カンマ区切り CIDR）。未設定なら制限なし。
# 許可外からは 404。自分の接続元が含まれることを確認してから設定すること。
# ADMIN_ALLOWED_NETWORKS=133.41.0.0/16
# API トークンの有効期限（発行からの日数。0 で無期限）。期限切れは管理者が再発行する。
# API_TOKEN_MAX_AGE_DAYS=365
# セキュリティ通知のしきい値（10 分間のログイン失敗: 同一 IP / サイト全体、MFA 連続失敗）
# SECURITY_LOGIN_FAILURES_PER_IP=10
# SECURITY_LOGIN_FAILURES_TOTAL=30
# SECURITY_MFA_FAILURES=3
